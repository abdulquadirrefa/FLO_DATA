# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .env (gitignored) and fill in your own values.
# All specs load it with dotenv from the project root.
# ─────────────────────────────────────────────────────────────────────────────

# ── Microsoft SSO login for Rapid (Iron Hide) and M3 ───────────────────────
# Which pair is used depends on `env` in config/m3/orderData.js.
UAT_EMAIL=
UAT_PASSWORD=
QA_EMAIL=
QA_PASSWORD=

# ── GRN raw-material web app (Keycloak) — UI flows and the GRN API flow ────
GRN_USERNAME=
GRN_PASSWORD=

# ── GRN handheld device UI (scanner login) ─────────────────────────────────
DEVICE_USERNAME=
DEVICE_PASSWORD=

# ── Optional ───────────────────────────────────────────────────────────────
# Bearer token for the location-update API (pl-split-grn, scanVia 'api').
# Only used when no token could be picked up from the logged-in GRN app.
SCAN_API_TOKEN=

# ─────────────────────────────────────────────────────────────────────────────
# Per-run overrides — usually set in the shell for one run rather than here,
# e.g. PowerShell:  $env:PO='1010050884'; npm run rescan
#
#   PO                     grn-api: comma/space-separated POs (default: data/m3/created-data.xlsx)
#                          rescan:  the single PO to rescan (required)
#   DRY_RUN=1              rescan: only count unscanned barcodes, scan nothing
#   POS                    confirm:parallel: comma-separated POs instead of data/grn/po-numbers.xlsx
#   VERIFY_ONLY=1          confirm:parallel: don't click Update M3, only wait for Completed
#   NO_WAIT=1              confirm:parallel: click Update M3 and move on without waiting
#   EXPECTED_LINES         confirm:parallel: total lines expected in Completed
#   COMPLETED_TIMEOUT_MIN  confirm:parallel: minutes to keep reloading Completed
# ─────────────────────────────────────────────────────────────────────────────
