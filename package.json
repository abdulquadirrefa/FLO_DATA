{
  "name": "flo_auto",
  "version": "1.0.0",
  "private": true,
  "description": "Playwright automation for Brandix FLO, M3 and GRN — M3 data creation (UI + API), GRN raw-material flows (UI, device and API) and the FLO regression suite",
  "license": "ISC",
  "type": "commonjs",
  "scripts": {
    "data":                     "playwright test tests/m3/data-creation.spec.js",
    "data:headed":              "playwright test tests/m3/data-creation.spec.js --headed",
    "data-api":                 "playwright test tests/m3/data-creation-api.spec.js",
    "data-api-generic":         "playwright test tests/m3/data-creation-api-generic.spec.js",
    "co-multi":                 "playwright test tests/m3/co-multiple-schedule.spec.js",
    "co-multi:headed":          "playwright test tests/m3/co-multiple-schedule.spec.js --headed",
    "session":                  "playwright test tests/m3/session-setup.spec.js",
    "approve-po":               "node scripts/approve-po.js",

    "grn-api":                  "playwright test tests/grn/grn-api.spec.js",
    "pl":                       "playwright test tests/grn/pl-creation.spec.js",
    "pl:headed":                "playwright test tests/grn/pl-creation.spec.js --headed",
    "pl-split":                 "playwright test tests/grn/pl-split-grn.spec.js",
    "pl-split:headed":          "playwright test tests/grn/pl-split-grn.spec.js --headed",
    "grn":                      "playwright test tests/grn/grn-scan.spec.js",
    "grn:headed":               "playwright test tests/grn/grn-scan.spec.js --headed",
    "rescan":                   "playwright test tests/grn/rescan-remaining.spec.js",
    "scan":                     "playwright test tests/grn/scan-and-confirm.spec.js",
    "scan:headed":              "playwright test tests/grn/scan-and-confirm.spec.js --headed",
    "scan:consolidated":        "playwright test tests/grn/consolidated-scan.spec.js",
    "confirm:parallel":         "playwright test tests/grn/confirm-grn-parallel.spec.js",

    "smoke":                    "playwright test --config=playwright.flo.config.js",
    "smoke:headed":             "playwright test --config=playwright.flo.config.js --headed",
    "smoke:debug":              "playwright test --config=playwright.flo.config.js --debug",
    "smoke:report":             "playwright show-report",
    "test:flo":                 "playwright test --config=playwright.flo.config.js",
    "master-po":                "playwright test tests/flo/master-po-flow.spec.js --config=playwright.flo.config.js",
    "master-po:headed":         "playwright test tests/flo/master-po-flow.spec.js --config=playwright.flo.config.js --headed",
    "master-po-reverse":        "playwright test tests/flo/master-po-reverse.spec.js --config=playwright.flo.config.js",
    "master-po-reverse:headed": "playwright test tests/flo/master-po-reverse.spec.js --config=playwright.flo.config.js --headed",
    "trims":                    "playwright test tests/flo/trims-inspection.spec.js --config=playwright.flo.config.js",
    "fabric":                   "playwright test tests/flo/fabric-inspection.spec.js --config=playwright.flo.config.js",

    "regression":               "playwright test --config=playwright.regression.config.js",
    "regression:headed":        "playwright test --config=playwright.regression.config.js --headed",
    "regression:debug":         "playwright test --config=playwright.regression.config.js --debug",
    "regression:report":        "playwright show-report",

    "test:ui":                  "playwright test --ui --config=playwright.config.js",
    "test:flo:ui":              "playwright test --ui --config=playwright.flo.config.js",
    "test:flo-reg:ui":          "playwright test --ui --config=playwright.regression.config.js"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@types/node": "^25.5.0"
  },
  "dependencies": {
    "dotenv": "^17.4.0",
    "xlsx": "^0.18.5"
  }
}
